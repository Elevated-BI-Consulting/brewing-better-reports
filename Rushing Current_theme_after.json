{
    "name": "Rushing Current",
    "dataColors": [
        "#12507D",
        "#11ADD4",
        "#F2714A",
        "#7C5CBF",
        "#F5B335",
        "#34B2A1",
        "#D9478C",
        "#6BA83C",
        "#082F4C",
        "#0A6E8C",
        "#A8411F",
        "#4A3379",
        "#A3741A",
        "#1C6E63",
        "#8C2B59",
        "#3E6B20",
        "#79BBD8",
        "#8FDCEE",
        "#F9AF93",
        "#B7A3E2",
        "#FBD88F",
        "#79BEAD",
        "#F0A2C4",
        "#B2D692",
        "#44667E",
        "#5EA8BA",
        "#C08A74",
        "#8E80A8",
        "#C3A673",
        "#819895",
        "#B07F97",
        "#8FA579"
    ],
    "background": "#FFFFFF",
    "foreground": "#666666",
    "tableAccent": "#b3b3b3",
    "good": "#1AAB40",
    "neutral": "#D9B300",
    "bad": "#D64554",
    "maximum": "#118DFF",
    "center": "#D9B300",
    "minimum": "#DEEFFF",
    "textClasses": {
        "callout": {
            "fontFace": "Segoe UI",
            "color": "#666666",
            "fontSize": 28
        },
        "title": {
            "fontFace": "Segoe UI",
            "color": "#666666",
            "fontSize": 10
        },
        "header": {
            "fontFace": "Segoe UI",
            "color": "#666666",
            "fontSize": 12
        },
        "label": {
            "fontFace": "Bahnschrift",
            "color": "#666666",
            "fontSize": 14
        },
        "smallLightLabel": {
            "color": "#666666",
            "fontFace": "Segoe UI",
            "fontSize": 10
        },
        "largeLightLabel": {
            "color": "#666666",
            "fontFace": "Segoe UI",
            "fontSize": 10
        },
        "boldLabel": {
            "fontFace": "Segoe UI"
        },
        "lightLabel": {
            "color": "#666666",
            "fontFace": "Segoe UI"
        },
        "smallLabel": {
            "fontSize": 10,
            "fontFace": "Segoe UI"
        },
        "largeLabel": {
            "fontFace": "Segoe UI",
            "fontSize": 10
        },
        "semiboldLabel": {
            "fontFace": "Segoe UI"
        },
        "largeTitle": {
            "fontFace": "Segoe UI",
            "fontSize": 12,
            "color": "#666666"
        }
    },
    "visualStyles": {
        "*": {
            "*": {
                "border": [
                    {
                        "color": {
                            "solid": {
                                "color": "#ffffff"
                            }
                        },
                        "show": true,
                        "radius": 5
                    }
                ],
                "title": [
                    {
                        "fontSize": 12,
                        "fontFamily": "Segoe UI",
                        "bold": true
                    },
                    {
                        "fontColor": {
                            "solid": {
                                "color": "#666666"
                            }
                        }
                    }
                ],
                "subTitle": [
                    {
                        "fontSize": 10,
                        "fontFamily": "Segoe UI"
                    },
                    {
                        "fontColor": {
                            "solid": {
                                "color": "#666666"
                            }
                        }
                    }
                ],
                "spacing": [
                    {
                        "customizeSpacing": true,
                        "spaceBelowTitle": 4,
                        "spaceBelowSubTitle": 4
                    }
                ],
                "legend": [
                    {
                        "showTitle": false,
                        "fontFamily": "Segoe UI",
                        "fontSize": 10
                    }
                ],
                "valueAxis": [
                    {
                        "fontSize": 10,
                        "fontFamily": "Segoe UI",
                        "titleFontSize": 10,
                        "titleFontFamily": "Segoe UI",
                        "showAxisTitle": false,
                        "innerPadding": 65
                    }
                ],
                "categoryAxis": [
                    {
                        "fontSize": 10,
                        "fontFamily": "Segoe UI",
                        "titleFontSize": 10,
                        "titleFontFamily": "Segoe UI",
                        "showAxisTitle": false,
                        "innerPadding": 65
                    }
                ],
                "labels": [
                    {
                        "show": true,
                        "fontSize": 14,
                        "fontFamily": "Bahnschrift",
                        "titleFontFamily": "Segoe UI",
                        "titleFontSize": 10,
                        "detailFontFamily": "Segoe UI",
                        "detailFontSize": 10,
                        "enableBackground": false,
                        "backgroundColor": {
                            "solid": {
                                "color": "#333333"
                            }
                        },
                        "backgroundTransparency": 90
                    }
                ],
                "totals": [
                    {
                        "fontSize": 10,
                        "fontFamily": "Segoe UI",
                        "bold": true
                    }
                ],
                "seriesLabels": [
                    {
                        "seriesFontFamily": "Segoe UI",
                        "textSize": 10
                    }
                ],
                "error": [
                    {
                        "labelFontFamily": "Segoe UI",
                        "labelFontSize": 10
                    }
                ],
                "padding": [
                    {
                        "top": 10,
                        "right": 10,
                        "bottom": 10,
                        "left": 10
                    }
                ],
                "lineStyles": [
                    {
                        "strokeWidth": 3,
                        "lineChartType": "smooth",
                        "interpolationSmooth": "monotoneX",
                        "showMarker": true,
                        "markerShape": "circle",
                        "markerSize": 5
                    }
                ]
            }
        },
        "shape": {
            "*": {
                "padding": [
                    {
                        "top": 0,
                        "right": 0,
                        "bottom": 0,
                        "left": 0
                    }
                ]
            }
        },
        "textbox": {
            "*": {
                "*": [
                    {
                        "fontSize": 19,
                        "fontFamily": "Segoe UI"
                    }
                ],
                "padding": [
                    {
                        "top": 10,
                        "right": 10,
                        "bottom": 10,
                        "left": 10
                    }
                ],
                "background": [
                    {
                        "show": false
                    }
                ],
                "border": [
                    {
                        "show": false
                    }
                ]
            }
        },
        "page": {
            "*": {
                "background": [
                    {
                        "image": {
                            "name": "Rushing Current Power BI Reporting Background",
                            "url": "data:image/png;base64,",
                            "scaling": "Fit"
                        },
                        "transparency": 0
                    }
                ]
            }
        },
        "cardVisual": {
            "*": {
                "layout": [
                    {
                        "maxTiles": 4,
                        "cellPadding": 16,
                        "verticalAlignment": "middle"
                    }
                ],
                "border": [
                    {
                        "show": false
                    }
                ],
                "shapeCustomRectangle": [
                    {
                        "$id": "default",
                        "tileShape": "rectangleRounded",
                        "rectangleRoundedCurve": 10
                    }
                ],
                "background": [
                    {
                        "show": false
                    }
                ],
                "outline": [
                    {
                        "$id": "default",
                        "lineColor": {
                            "solid": {
                                "color": "#ffffff"
                            }
                        },
                        "show": true
                    }
                ]
            }
        },
        "slicer": {
            "*": {
                "padding": [
                    {
                        "top": 10,
                        "right": 10,
                        "bottom": 10,
                        "left": 10
                    }
                ],
                "border": [
                    {
                        "show": false
                    }
                ],
                "background": [
                    {
                        "show": false
                    }
                ],
                "slider": [
                    {
                        "show": false
                    }
                ],
                "data": [
                    {
                        "mode": "RelativeDatePicker"
                    }
                ]
            }
        },
        "advancedSlicerVisual": {
            "*": {
                "title": [
                    {
                        "show": false
                    }
                ],
                "border": [
                    {
                        "show": false
                    }
                ],
                "background": [
                    {
                        "show": false
                    }
                ],
                "shape": [
                    {
                        "rectangleRoundedCurve": 5
                    }
                ],
                "padding": [
                    {
                        "top": 10,
                        "right": 10,
                        "bottom": 10,
                        "left": 10
                    }
                ]
            }
        },
        "pageNavigator": {
            "*": {
                "padding": [
                    {
                        "top": 10,
                        "right": 10,
                        "bottom": 10,
                        "left": 10
                    }
                ],
                "border": [
                    {
                        "show": false
                    }
                ],
                "shape": [
                    {
                        "rectangleRoundedCurve": 5
                    }
                ],
                "outline": [
                    {
                        "show": true,
                        "$id": "default",
                        "rectangleRoundedCurve": 20,
                        "lineColor": {
                            "solid": {
                                "color": "#E6E6E6"
                            }
                        }
                    }
                ]
            }
        },
        "bookmarkNavigator": {
            "*": {
                "padding": [
                    {
                        "top": 10,
                        "right": 10,
                        "bottom": 10,
                        "left": 10
                    }
                ],
                "border": [
                    {
                        "show": false
                    }
                ],
                "outline": [
                    {
                        "show": true,
                        "$id": "default",
                        "lineColor": {
                            "solid": {
                                "color": "#E6E6E6"
                            }
                        }
                    }
                ],
                "shape": [
                    {
                        "rectangleRoundedCurve": 5
                    }
                ]
            }
        },
        "actionButton": {
            "*": {
                "text": [
                    {
                        "$id": "default",
                        "show": true,
                        "fontSize": 10,
                        "fontFamily": "Segoe UI",
                        "bold": true,
                        "verticalAlignment": "middle",
                        "horizontalAlignment": "center",
                        "topMargin": 4,
                        "bottomMargin": 4,
                        "rightMargin": 4,
                        "leftMargin": 4
                    }
                ],
                "border": [
                    {
                        "show": false
                    }
                ]
            }
        }
    }
}