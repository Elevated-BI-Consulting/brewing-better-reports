{
    "name": "Rushing Current",
    "dataColors": [
        "#12507D",
        "#1380AE",
        "#11ADD4",
        "#30D6E8",
        "#5AE2DD",
        "#34B2A1",
        "#22876D",
        "#90D5B2",
        "#051D2E",
        "#08445E",
        "#076A83",
        "#0E9FAF",
        "#1CC4BF",
        "#1C6E63",
        "#0D3F33",
        "#47C285",
        "#5798C7",
        "#79BBD8",
        "#91D3E3",
        "#BCE7EB",
        "#DAF1F0",
        "#A5CFC9",
        "#79BEAD",
        "#E7EFEB",
        "#44667E",
        "#508CA5",
        "#5EA8BA",
        "#87BFC5",
        "#A6C9C8",
        "#819895",
        "#5D7E76",
        "#C8D0CC"
    ],
    "background": "#FFFFFF",
    "foreground": "#24212E",
    "tableAccent": "#b3b3b3",
    "good": "#1AAB40",
    "neutral": "#D9B300",
    "bad": "#D64554",
    "maximum": "#118DFF",
    "center": "#D9B300",
    "minimum": "#DEEFFF",
    "textClasses": {
        "callout": {
            "fontFace": "Segoe UI",
            "color": "#333333",
            "fontSize": 28
        },
        "title": {
            "fontFace": "Segoe UI",
            "color": "#333333",
            "fontSize": 10
        },
        "header": {
            "fontFace": "Segoe UI",
            "color": "#333333",
            "fontSize": 12
        },
        "label": {
            "fontFace": "Segoe UI",
            "color": "#B3B3B3",
            "fontSize": 10
        },
        "smallLightLabel": {
            "color": "#605E5C",
            "fontFace": "Segoe UI",
            "fontSize": 10
        },
        "largeLightLabel": {
            "color": "#605E5C",
            "fontFace": "Segoe UI",
            "fontSize": 10
        },
        "boldLabel": {
            "fontFace": "Segoe UI"
        },
        "lightLabel": {
            "color": "#605E5C"
        },
        "smallLabel": {
            "fontSize": 10
        },
        "largeLabel": {
            "fontFace": "Segoe UI",
            "fontSize": 10
        },
        "semiboldLabel": {
            "fontFace": "Segoe UI"
        },
        "largeTitle": {
            "fontFace": "Segoe UI",
            "fontSize": 12,
            "color": "#000000"
        }
    },
    "visualStyles": {
        "*": {
            "*": {
                "border": [
                    {
                        "color": {
                            "solid": {
                                "color": "#ffffff"
                            }
                        },
                        "show": true,
                        "radius": 5
                    }
                ],
                "title": [
                    {
                        "fontSize": 12,
                        "fontFamily": "Segoe UI",
                        "bold": true
                    },
                    {
                        "fontColor": {
                            "solid": {
                                "color": "#333333"
                            }
                        }
                    }
                ],
                "subTitle": [
                    {
                        "fontSize": 10,
                        "fontFamily": "Segoe UI"
                    },
                    {
                        "fontColor": {
                            "solid": {
                                "color": "#B3B3B3"
                            }
                        }
                    }
                ],
                "spacing": [
                    {
                        "customizeSpacing": true,
                        "spaceBelowTitle": 4,
                        "spaceBelowSubTitle": 4
                    }
                ],
                "legend": [
                    {
                        "showTitle": false,
                        "fontFamily": "Segoe UI",
                        "fontSize": 10
                    }
                ],
                "valueAxis": [
                    {
                        "fontSize": 10,
                        "fontFamily": "Segoe UI",
                        "titleFontSize": 10,
                        "titleFontFamily": "Segoe UI",
                        "showAxisTitle": false,
                        "innerPadding": 65
                    }
                ],
                "categoryAxis": [
                    {
                        "fontSize": 10,
                        "fontFamily": "Segoe UI",
                        "titleFontSize": 10,
                        "titleFontFamily": "Segoe UI",
                        "showAxisTitle": false,
                        "innerPadding": 65
                    }
                ],
                "labels": [
                    {
                        "show": true,
                        "fontSize": 10,
                        "fontFamily": "Segoe UI",
                        "titleFontFamily": "Segoe UI",
                        "titleFontSize": 10,
                        "detailFontFamily": "Segoe UI",
                        "detailFontSize": 10,
                        "enableBackground": false,
                        "backgroundColor": {
                            "solid": {
                                "color": "#333333"
                            }
                        },
                        "backgroundTransparency": 90
                    }
                ],
                "totals": [
                    {
                        "fontSize": 10,
                        "fontFamily": "Segoe UI",
                        "bold": true
                    }
                ],
                "seriesLabels": [
                    {
                        "seriesFontFamily": "Segoe UI",
                        "textSize": 10
                    }
                ],
                "error": [
                    {
                        "labelFontFamily": "Segoe UI",
                        "labelFontSize": 10
                    }
                ],
                "padding": [
                    {
                        "top": 10,
                        "right": 10,
                        "bottom": 10,
                        "left": 10
                    }
                ],
                "lineStyles": [
                    {
                        "strokeWidth": 3,
                        "lineChartType": "smooth",
                        "interpolationSmooth": "monotoneX",
                        "showMarker": true,
                        "markerShape": "circle",
                        "markerSize": 5
                    }
                ]
            }
        },
        "shape": {
            "*": {
                "padding": [
                    {
                        "top": 0,
                        "right": 0,
                        "bottom": 0,
                        "left": 0
                    }
                ]
            }
        },
        "textbox": {
            "*": {
                "*": [
                    {
                        "fontSize": 19,
                        "fontFamily": "Segoe UI"
                    }
                ],
                "padding": [
                    {
                        "top": 10,
                        "right": 10,
                        "bottom": 10,
                        "left": 10
                    }
                ],
                "background": [
                    {
                        "show": false
                    }
                ]
            }
        },
        "page": {
            "*": {
                "background": [
                    {
                        "image": {
                            "name": "Rushing Current Power BI Reporting Background",
                            "url": "data:image/png;base64,",
                            "scaling": "Fit"
                        },
                        "transparency": 0
                    }
                ]
            }
        },
        "cardVisual": {
            "*": {
                "layout": [
                    {
                        "maxTiles": 4,
                        "cellPadding": 16,
                        "verticalAlignment": "middle"
                    }
                ],
                "border": [
                    {
                        "show": false
                    }
                ],
                "shapeCustomRectangle": [
                    {
                        "$id": "default",
                        "tileShape": "rectangleRounded",
                        "rectangleRoundedCurve": 10
                    }
                ],
                "background": [
                    {
                        "show": false
                    }
                ],
                "outline": [
                    {
                        "$id": "default",
                        "lineColor": {
                            "solid": {
                                "color": "#ffffff"
                            }
                        },
                        "show": true
                    }
                ]
            }
        },
        "slicer": {
            "*": {
                "padding": [
                    {
                        "top": 10,
                        "right": 10,
                        "bottom": 10,
                        "left": 10
                    }
                ],
                "border": [
                    {
                        "show": false
                    }
                ],
                "background": [
                    {
                        "show": false
                    }
                ]
            }
        },
        "advancedSlicerVisual": {
            "*": {
                "title": [
                    {
                        "show": false
                    }
                ],
                "border": [
                    {
                        "show": false
                    }
                ],
                "background": [
                    {
                        "show": false
                    }
                ],
                "shape": [
                    {
                        "rectangleRoundedCurve": 5
                    }
                ],
                "padding": [
                    {
                        "top": 10,
                        "right": 10,
                        "bottom": 10,
                        "left": 10
                    }
                ]
            }
        },
        "pageNavigator": {
            "*": {
                "padding": [
                    {
                        "top": 10,
                        "right": 10,
                        "bottom": 10,
                        "left": 10
                    }
                ],
                "border": [
                    {
                        "show": false
                    }
                ],
                "shape": [
                    {
                        "rectangleRoundedCurve": 5
                    }
                ],
                "outline": [
                    {
                        "show": true,
                        "$id": "default",
                        "rectangleRoundedCurve": 20,
                        "lineColor": {
                            "solid": {
                                "color": "#E6E6E6"
                            }
                        }
                    }
                ]
            }
        },
        "bookmarkNavigator": {
            "*": {
                "padding": [
                    {
                        "top": 10,
                        "right": 10,
                        "bottom": 10,
                        "left": 10
                    }
                ],
                "border": [
                    {
                        "show": false
                    }
                ],
                "outline": [
                    {
                        "show": true,
                        "$id": "default",
                        "lineColor": {
                            "solid": {
                                "color": "#E6E6E6"
                            }
                        }
                    }
                ],
                "shape": [
                    {
                        "rectangleRoundedCurve": 5
                    }
                ]
            }
        },
        "actionButton": {
            "*": {
                "text": [
                    {
                        "$id": "default",
                        "show": true,
                        "fontSize": 10,
                        "fontFamily": "Segoe UI",
                        "bold": true,
                        "verticalAlignment": "middle",
                        "horizontalAlignment": "center",
                        "topMargin": 4,
                        "bottomMargin": 4,
                        "rightMargin": 4,
                        "leftMargin": 4
                    }
                ],
                "border": [
                    {
                        "show": false
                    }
                ]
            }
        }
    }
}