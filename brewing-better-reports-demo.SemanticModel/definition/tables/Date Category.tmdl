table 'Date Category'
	lineageTag: 6975fe86-362f-49b2-8688-62835c93fbaf

	column Date
		isHidden
		formatString: Short Date
		lineageTag: b7b690fd-2a97-4658-bca7-cded64fcb438
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column 'Date Category'
		lineageTag: feeadf4b-daef-4e00-9ae7-a6d52d479b49
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date Category]
