table 'Time Period'
	lineageTag: 046259f3-1328-4c62-bc95-7ac91c1e56fd

	calculationGroup

		calculationItem WTD =
				
				VAR _maxdate =
				    MIN (
				        MAX ( 'Date'[date] ),
				        DATE ( 2026, 03, 25 ) -- TODAY()
				    )
				VAR _mindate =
				    MIN ( 'Date'[date] )
				VAR _currentyear =
				    LOOKUPVALUE (
				        'Date'[year],
				        'Date'[date], _maxdate
				    )
				VAR _weeknumber =
				    LOOKUPVALUE (
				        'Date'[wnumber],
				        'Date'[date], _maxdate
				    )
				VAR _datetbl =
				    FILTER (
				        ALL ( 'Date' ),
				        'Date'[year] = _currentyear
				            && 'Date'[wnumber] = _weeknumber
				            && 'Date'[date] <= _maxdate
				)
				
				RETURN
				CALCULATE (
				    SELECTEDMEASURE (),
				    _datetbl
				)

			formatStringDefinition =
					SWITCH (
					    TRUE(),
					    CONTAINSSTRING ( SELECTEDMEASURENAME(), "profit per case" ), "$#,##0.00",
					    CONTAINSSTRING ( SELECTEDMEASURENAME(), "%" ), "#,##0.0%;(#,##0.0%)",
					    CONTAINSSTRING ( SELECTEDMEASURENAME(), "profit" )
					        || CONTAINSSTRING ( SELECTEDMEASURENAME(), "gross" ), "$#,##0",
					    "#,###"
					)

		calculationItem 'WTD PY' = ```
				
				VAR _maxdate = 
				MIN (
				   MAX ( 'Date'[Date] )
				   , DATE ( 2026, 03, 25 ) -- TODAY()
				)
				VAR _mindate = MIN ( 'Date'[Date] )
				VAR _currentyear = 
				LOOKUPVALUE ( 
				    'Date'[Year],
				    'Date'[Date], _maxdate
				)
				VAR _weeknumber = 
				LOOKUPVALUE ( 
				    'Date'[wnumber],
				    'Date'[Date], _maxdate
				)
				VAR _maxdaynumber = 
				LOOKUPVALUE ( 
				    'Date'[day_of_week],
				    'Date'[Date], _maxdate
				)
				VAR _datetbl =
				FILTER(
				    ALL ( 'Date' ), 
				    'Date'[Year] = _currentyear - 1
				        && 'Date'[wnumber] = _weeknumber
				        && 'Date'[day_of_week] <= _maxdaynumber
				)
				
				RETURN
				CALCULATE (
				    SELECTEDMEASURE (),
				    _datetbl
				)
				```

