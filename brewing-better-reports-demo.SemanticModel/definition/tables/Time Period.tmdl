		calculationItem 'MTD PY %Δ' = ```
				-- MTD
				VAR _maxdate =
				MIN (
				    -- sets max date for calculation so that TODAY() will be used
				    MAX ( 'Date'[Date] ) -- in the event that [Date] is not applied as a filter on the visual
				    ,DATE ( 2026, 03, 25 ) -- TODAY()
				)
				VAR _mindate =
				DATE ( YEAR ( _maxdate ), MONTH ( _maxdate ), 1 )
				VAR _datetbl =
				FILTER (
				    ALL ( 'Date' ),
				    'Date'[Date] >= _mindate
				        && 'Date'[Date] <= _maxdate
				)
				VAR _MTDresult =
				CALCULATE (
				    SELECTEDMEASURE (),
				    _datetbl
				) 
				
				-- MTD PY
				VAR _PYmaxdate =
				DATE ( YEAR ( _maxdate ) - 1, MONTH ( _maxdate ), DAY ( _maxdate ) )
				VAR _PYmindate =
				DATE ( YEAR ( _maxdate ) - 1, MONTH ( _maxdate ), 1 )
				VAR _PYdatetbl =
				FILTER (
				    ALL ( 'Date' ),
				    'Date'[Date] >= _PYmindate
				        && 'Date'[Date] <= _PYmaxdate
				)
				VAR _PYresult =
				CALCULATE (
				    SELECTEDMEASURE (),
				    _PYdatetbl
				)
				VAR _variance = _MTDresult - _PYresult
				
				RETURN
				DIVIDE (
				    _variance,
				    _PYresult,
				    0
				)
				```

			formatStringDefinition = "#,##0.0%;(#,##0.0%)"

		calculationItem YTD = ```
				VAR _maxdate =
				MIN (                          
				    MAX ( 'Date'[date] ),    
				    DATE ( 2026, 03, 25 ) -- TODAY()
				)
				VAR _mindate = DATE ( YEAR ( _maxdate ), 1, 1 )
				VAR _datetbl = 
				FILTER ( 
				    ALL ( 'Date' ),
				    'Date'[Date] >= _mindate
				        && 'Date'[Date] <= _maxdate
				)
				VAR _result = 
				SUMX ( 
				    _datetbl,
				    SELECTEDMEASURE()
				)
				
				RETURN
				CALCULATE (
				    SELECTEDMEASURE()
				    , _datetbl
				  )
				```

