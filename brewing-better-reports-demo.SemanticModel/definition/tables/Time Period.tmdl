		calculationItem 'WTD PY %Δ' = ```
				-- WTD 
				
				VAR _maxdate = 
				MIN (
				   MAX ( 'Date'[Date] )
				    , DATE ( 2026, 03, 25 ) -- TODAY()
				)
				VAR _maxweek = 
				LOOKUPVALUE ( 
				    'Date'[Wk_Index],
				    'Date'[Date], _maxdate
				)
				VAR _datetbl =
				FILTER(
				    ALL ( 'Date' ), 
				    'Date'[Wk_Index] = _maxweek
				        && 'Date'[Date] <= _maxdate
				)
				VAR _WTDresult = 
				CALCULATE(
				    SELECTEDMEASURE()
				    , _datetbl
				)
				
				-- WTD PY
				VAR _weeknumber = 
				LOOKUPVALUE ( 
				    'Date'[wnumber],
				    'Date'[Date], _maxdate
				)
				VAR _maxdaynumber = 
				LOOKUPVALUE ( 
				    'Date'[day_of_week],
				    'Date'[Date], _maxdate
				)
				VAR _PYdatetbl =
				FILTER(
				    ALL ( 'Date' ), 
				    'Date'[Year] = YEAR ( _maxdate ) - 1
				        && 'Date'[wnumber] = _weeknumber
				        && 'Date'[day_of_week] <= _maxdaynumber
				)
				VAR _PYresult = 
				CALCULATE (
				    SELECTEDMEASURE()
				    , _PYdatetbl
				)
				
				VAR _variance = _WTDresult - _PYresult
				
				RETURN
				DIVIDE ( _variance, _PYresult, 0 )
				```

			formatStringDefinition = "#,##0.0%;(#,##0.0%)"

		calculationItem MTD =
				VAR _maxdate =
				    MIN (
				        -- sets max date for calculation so that TODAY() will be used
				        MAX ( 'Date'[Date] ) -- in the event that [Date] is not applied as a filter on the visual
				        , DATE ( 2026, 03, 25 ) -- TODAY()
				
				    )
				VAR _mindate =
				    DATE ( YEAR ( _maxdate ), MONTH ( _maxdate ), 1 )
				VAR _datetbl =
				    FILTER (
				        ALL ( 'Date' ),
				        'Date'[Date] >= _mindate
				            && 'Date'[Date] <= _maxdate
				    )
				
				RETURN
				CALCULATE (
				    SELECTEDMEASURE (),
				    _datetbl
				)

			formatStringDefinition =
					SWITCH (
					    TRUE(),
					    CONTAINSSTRING ( SELECTEDMEASURENAME(), "profit per case" ), "$#,##0.00",
					    CONTAINSSTRING ( SELECTEDMEASURENAME(), "%" ), "#,##0.0%;(#,##0.0%)",
					    CONTAINSSTRING ( SELECTEDMEASURENAME(), "profit" )
					        || CONTAINSSTRING ( SELECTEDMEASURENAME(), "gross" ), "$#,##0",
					    "#,###"
					)

		calculationItem 'MTD PY' = ```
				VAR _maxdate =
				MIN (                           -- sets max date for calculation so that TODAY() will be used
				    MAX ( 'Date'[Date] )    -- in the event that [Date] is not applied as a filter on the visual
				    , DATE ( 2026, 03, 25 ) -- TODAY()
				)
				VAR _PYmaxdate = DATE ( YEAR ( _maxdate ) - 1, MONTH ( _maxdate ) , DAY ( _maxdate ) )
				VAR _PYmindate = DATE ( YEAR ( _maxdate ) - 1, MONTH ( _maxdate), 1 )
				VAR _datetbl = 
				FILTER ( 
				    ALL ( 'Date' )
				    , 'Date'[Date] >= _PYmindate
				        && 'Date'[Date] <= _PYmaxdate
				)
				
				RETURN
				CALCULATE (
				    SELECTEDMEASURE()
				    , _datetbl
				)
				```

