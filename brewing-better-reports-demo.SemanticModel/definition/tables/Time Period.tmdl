		calculationItem 'YTD PY Var' = ```
				-- YTD
				VAR _maxdate =
				MIN (                          
				    MAX ( 'Date'[date] ),    
				    DATE ( 2026, 03, 25 ) -- TODAY()
				)
				VAR _mindate = DATE ( YEAR ( _maxdate ), 1, 1 )
