		calculationItem 'WTD PY Var' = ```
				-- WTD 
				
				VAR _maxdate = 
				MIN (
				   MAX ( 'Date'[Date] )
				   ,DATE ( 2026, 03, 25 ) -- TODAY()
				)
				VAR _maxweek = 
				LOOKUPVALUE ( 
				    'Date'[wk_index],
				    'Date'[Date], _maxdate
				)
				VAR _datetbl =
				FILTER(
				    ALL ( 'Date' ), 
				    'Date'[wk_index] = _maxweek
				        && 'Date'[Date] <= _maxdate
				)
				VAR _WTDresult = 
				CALCULATE (
				    SELECTEDMEASURE()
				    , _datetbl
				)
				
				
				-- WTD PY
				VAR _weeknumber = 
				LOOKUPVALUE ( 
				    'Date'[wnumber],
				    'Date'[Date], _maxdate
				)
				VAR _maxdaynumber = 
				LOOKUPVALUE ( 
				    'Date'[day_of_week],
				    'Date'[Date], _maxdate
				)
				VAR _PYdatetbl =
				FILTER(
				    ALL ( 'Date' ), 
				    'Date'[Year] = YEAR ( _maxdate ) - 1
				        && 'Date'[wnumber] = _weeknumber
				        && 'Date'[day_of_week] <= _maxdaynumber
				)
				VAR _PYresult = 
				CALCULATE (
				    SELECTEDMEASURE() 
				    , _PYdatetbl
				)
				
				RETURN
				_WTDresult - _PYresult
				```

