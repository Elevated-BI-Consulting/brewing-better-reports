	column 'Time Period Group' =
			
			SWITCH (
			    TRUE()
			    , CONTAINSSTRING ( [Name], "WTD" )
			        , "WTD"
			    , CONTAINSSTRING ( [Name], "MTD" )
			        , "MTD"
			    , CONTAINSSTRING ( [Name], "YTD" )
