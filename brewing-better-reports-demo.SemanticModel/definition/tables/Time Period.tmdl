		annotation SummarizationSetBy = Automatic

	column TimePeriodGroupSort = ```
			
			SWITCH ( 
			    TRUE()
			    , CONTAINSSTRING ( [Name], "WTD" )
			        , 1
			    , CONTAINSSTRING ( [Name], "MTD" )
			        , 2
			    , CONTAINSSTRING ( [Name], "TTD" )
			        , 3
			    , CONTAINSSTRING ( [Name], "YTD" )
			        , 4
