				VAR _PYmindate = DATE ( YEAR ( _maxdate ) - 1, 1, 1 )
				VAR _datetbl = 
				FILTER ( 
				    ALL ( 'Date' )
				    , 'Date'[Date] >= _PYmindate
				        && 'Date'[Date] <= _PYmaxdate
				)
				VAR _ytdpyresult = 
				CALCULATE(
				    SELECTEDMEASURE()
				    , _datetbl
				)
				
				
				
				RETURN
				_ytdresult - _ytdpyresult
