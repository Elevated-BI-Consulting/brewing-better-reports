				VAR _PYmaxdate = DATE ( YEAR ( _maxdate ) - 1, MONTH ( _maxdate ), DAY ( _maxdate ) )
				VAR _PYmindate = DATE ( YEAR ( _maxdate ) - 1, 1, 1 )
				VAR _datetbl = 
				FILTER ( 
				    ALL ( 'Date' )
				    , 'Date'[Date] >= _PYmindate
