model brewing-better-reports-demo
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

annotation PBI_QueryOrder = ["Invoice","Item","Account","Date"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation __TEdtr = 1

ref table Invoice
ref table Item
ref table Account
ref table Date
ref table 'Time Period'
ref table Parameter-TimePeriods
ref table 'Key Dimensions'
ref table 'Key Date Dimensions'
ref table 'Key Measures'
ref table 'Date Category'

ref cultureInfo en-US

